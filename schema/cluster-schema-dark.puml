@startuml cluster-schema-dark

skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #e0e0e0
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam nodesep 30
skinparam ranksep 45

skinparam rectangle {
  backgroundColor #16213e
  borderColor #0f3460
  fontColor #e0e0e0
}
skinparam database {
  backgroundColor #16213e
  borderColor #0f3460
  fontColor #e0e0e0
}
skinparam cloud {
  backgroundColor #0f3460
  borderColor #e94560
  fontColor #e0e0e0
}
skinparam actor {
  backgroundColor #0f3460
  borderColor #e94560
  fontColor #e0e0e0
}
skinparam node {
  backgroundColor #111827
  borderColor #1e3a5f
  fontColor #e0e0e0
}
skinparam frame {
  backgroundColor #0d1117
  borderColor #1e3a5f
  fontColor #7f8c9b
}
skinparam arrow {
  color #537791
  fontColor #94a3b8
  fontSize 11
}

cloud "  **Internet**  " as inet
actor "**Home devices**" as lan
cloud "  **Bitwarden**  //passwords//  " as bw

node "  **homelab**  //Ryzen 5 2600X · 32 GB//  " as host {

  frame "Way in" as entry {
    rectangle "**Cloudflare Tunnel**" as cf
    rectangle "**AdGuard**  //DNS//" as ag
    rectangle "**Traefik**" as tr
    rectangle "**Authentik**  //login//" as auth
  }

  frame "Public   *.gabro.ovh" as pub {
    rectangle "**Jellyfin**" as jf
    rectangle "**Immich**" as im
    rectangle "**Nextcloud**" as nc
    rectangle "**Navidrome**" as nv
    rectangle "**Matrix**" as mx
    rectangle "**Dispatcharr**" as dp
    rectangle "**Grafana**" as graf
    rectangle "**Centralino**" as cen
    rectangle "**GitLab**" as gl
  }

  frame "Home only   *.local.gabro.ovh" as home {
    rectangle "***arr stack**" as sarr
    rectangle "**Homepage**" as hp
    rectangle "**Headlamp**" as hl
    rectangle "**Pankha**" as pk
  }

  frame "Behind the scenes" as ops {
    rectangle "**Flux**  //config from GitLab//" as git
    rectangle "**Prometheus · Loki**  //monitoring//" as mon
    rectangle "**restic**  //weekly backups//" as bkp
  }

  frame "Data" as data {
    database "**PostgreSQL**" as pg
    database "**Valkey · Redis**" as rd
    database "**MinIO**  //S3//" as s3
  }

  frame "Disks" as disks {
    database "**1 TB NVMe**  //apps//" as d1
    database "**500 GB NVMe**  //photos//" as d2
    database "**Media disks**  //films · TV · music//" as d3
    database "**2 TB HDD**  //backups//" as d4
  }
}

inet -[hidden]right-> lan
lan -[hidden]right-> bw
cf -[hidden]right-> ag
auth -[hidden]right-> tr

jf -[hidden]right-> im
im -[hidden]right-> nc
nc -[hidden]right-> nv
mx -[hidden]right-> dp
dp -[hidden]right-> graf
graf -[hidden]right-> cen
nv -[hidden]right-> gl
jf -[hidden]down-> mx

sarr -[hidden]right-> hp
hl -[hidden]right-> pk
sarr -[hidden]down-> hl

pg -[hidden]right-> rd
rd -[hidden]right-> s3
git -[hidden]right-> mon
mon -[hidden]right-> bkp

d3 -[hidden]right-> d2
d2 -[hidden]right-> d1
d1 -[hidden]right-> d4

pub -[hidden]right-> home
mx -[hidden]down-> pg
pk -[hidden]down-> git
pg -[hidden]down-> d3

inet -[#e94560,bold]down-> cf : " HTTPS"
cf -[#e94560]down-> tr
tr -[#e94560]left-> auth
auth -[#e94560]down-> pub : " logged in"

lan -[#24A1C1,bold]down-> ag : " DNS"
ag .[#24A1C1].> tr
tr -[#24A1C1]down-> home

bw -[#a78bfa]down-> host : " secrets"

pub -[#537791]down-> data
data -[#537791]down-> d1
im -[#537791]down-> d2
jf -[#537791]down-> d3
sarr -[#537791]down-> d3
bkp -[#7f8c9b]down-> d4

@enduml
