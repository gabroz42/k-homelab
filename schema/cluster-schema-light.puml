@startuml cluster-schema-light

skinparam backgroundColor #ffffff
skinparam defaultFontColor #1e293b
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam nodesep 30
skinparam ranksep 45

skinparam rectangle {
  backgroundColor #f1f5f9
  borderColor #94a3b8
  fontColor #1e293b
}
skinparam database {
  backgroundColor #f1f5f9
  borderColor #94a3b8
  fontColor #1e293b
}
skinparam cloud {
  backgroundColor #dbeafe
  borderColor #3b82f6
  fontColor #1e293b
}
skinparam actor {
  backgroundColor #dbeafe
  borderColor #3b82f6
  fontColor #1e293b
}
skinparam node {
  backgroundColor #f8fafc
  borderColor #cbd5e1
  fontColor #1e293b
}
skinparam frame {
  backgroundColor #f0f4f8
  borderColor #cbd5e1
  fontColor #64748b
}
skinparam arrow {
  color #64748b
  fontColor #475569
  fontSize 11
}

cloud "  **Internet**  " as inet
actor "**Home devices**" as lan
cloud "  **Bitwarden**  //passwords//  " as bw

node "  **homelab**  //Ryzen 5 2600X · 32 GB//  " as host {

  frame "Way in" as entry {
    rectangle "**Cloudflare Tunnel**" as cf
    rectangle "**AdGuard**  //DNS//" as ag
    rectangle "**Traefik**" as tr
    rectangle "**Authentik**  //login//" as auth
  }

  frame "Public   *.gabro.ovh" as pub {
    rectangle "**Jellyfin**" as jf
    rectangle "**Immich**" as im
    rectangle "**Nextcloud**" as nc
    rectangle "**Navidrome**" as nv
    rectangle "**Matrix**" as mx
    rectangle "**Dispatcharr**" as dp
    rectangle "**Grafana**" as graf
    rectangle "**Centralino**" as cen
  }

  frame "Home only   *.local.gabro.ovh" as home {
    rectangle "***arr stack**" as sarr
    rectangle "**Homepage**" as hp
    rectangle "**Headlamp**" as hl
    rectangle "**Pankha**" as pk
  }

  frame "Behind the scenes" as ops {
    rectangle "**GitLab** → **Flux**  //config//" as git
    rectangle "**Prometheus · Loki**  //monitoring//" as mon
    rectangle "**restic**  //weekly backups//" as bkp
  }

  frame "Data" as data {
    database "**PostgreSQL**" as pg
    database "**Valkey · Redis**" as rd
    database "**MinIO**  //S3//" as s3
  }

  frame "Disks" as disks {
    database "**1 TB NVMe**  //apps//" as d1
    database "**500 GB NVMe**  //photos//" as d2
    database "**Media disks**  //films · TV · music//" as d3
    database "**2 TB HDD**  //backups//" as d4
  }
}

inet -[hidden]right-> lan
lan -[hidden]right-> bw
cf -[hidden]right-> ag
auth -[hidden]right-> tr

jf -[hidden]right-> im
im -[hidden]right-> nc
nc -[hidden]right-> nv
mx -[hidden]right-> dp
dp -[hidden]right-> graf
graf -[hidden]right-> cen
jf -[hidden]down-> mx

sarr -[hidden]right-> hp
hl -[hidden]right-> pk
sarr -[hidden]down-> hl

pg -[hidden]right-> rd
rd -[hidden]right-> s3
git -[hidden]right-> mon
mon -[hidden]right-> bkp

d3 -[hidden]right-> d2
d2 -[hidden]right-> d1
d1 -[hidden]right-> d4

pub -[hidden]right-> home
mx -[hidden]down-> pg
pk -[hidden]down-> git
pg -[hidden]down-> d3

inet -[#dc2626,bold]down-> cf : " HTTPS"
cf -[#dc2626]down-> tr
tr -[#dc2626]left-> auth
auth -[#dc2626]down-> pub : " logged in"

lan -[#0891b2,bold]down-> ag : " DNS"
ag .[#0891b2].> tr
tr -[#0891b2]down-> home

bw -[#7c3aed]down-> host : " secrets"

pub -[#3b82f6]down-> data
data -[#3b82f6]down-> d1
im -[#3b82f6]down-> d2
jf -[#3b82f6]down-> d3
sarr -[#3b82f6]down-> d3
bkp -[#64748b]down-> d4

@enduml
