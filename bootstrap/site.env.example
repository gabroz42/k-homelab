# Site inputs for bootstrap/bootstrap.sh and bootstrap/render-settings.sh.
# Copy to bootstrap/site.env (gitignored), fill in, then:
#   1. bootstrap/render-settings.sh      -> rewrites clusters/homelab/cluster-settings.yaml
#   2. git commit + push that file
#   3. sudo bootstrap/bootstrap.sh       -> on the new machine
# This file is sourced by bash: quote values, arrays use ( ... ).

# --- cluster-settings (every key of clusters/homelab/cluster-settings.yaml must be set) ---
PUBLIC_DOMAIN=example.com
LOCAL_DOMAIN=local.example.com
TIMEZONE=Europe/Rome
LETSENCRYPT_EMAIL=admin@example.com

PRIMARY_NODE=homelab
STATELESS_NODE=homelab
CLUSTER_NAME=homelab
PRIMARY_NODE_IP=192.168.1.10
LAN_CIDR=192.168.1.0/24
LAN_SUPERNET=192.168.0.0/16
POD_CIDR=10.42.0.0/16
LB_RANGE=192.168.1.55-192.168.1.100
TRAEFIK_IP=192.168.1.55
ADGUARD_IP=192.168.1.60
ESP32_SALA_IP=192.168.1.50
ESP32_TAVERNA_IP=192.168.1.51
ESP32_GARAGE_IP=192.168.1.52

BACKUP_PATH=/mnt/backups
NVME_PATH=/mnt/nvme500
MEDIA_PATH=/srv/media
MUSIC_PATH=/srv/music

BW_ORG_ID=00000000-0000-0000-0000-000000000000
BW_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- bootstrap only (never written to git) ---
K3S_VERSION=v1.36.5+k3s1
GITHUB_OWNER=your-github-user
GITHUB_REPO=k-homelab
GITHUB_BRANCH=main
GITHUB_TOKEN=
BWS_ACCESS_TOKEN=

# fstab-style entries: "<device> <mountpoint> <fstype> <options>". nofail is added if missing.
DISK_MOUNTS=(
  "UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx /mnt/backups ext4 defaults,noatime"
  "UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx /mnt/nvme500 ext4 defaults,noatime"
)

# Extra Longhorn disks: "<name> <path> <tag,tag>". Never list the backup disk here.
# apps/immich/immich-pvc.yaml requires a disk tagged disk-1; with no such entry the
# default disk (/var/lib/longhorn) gets the disk-1 tag instead.
LONGHORN_EXTRA_DISKS=(
  "disk-1 /mnt/nvme500 disk-1,nvme500"
)

# Optional: spin down the backup HDD when idle (hdparm -S units; 180 = 15 min).
BACKUP_DISK_SERIAL=
HDPARM_SPINDOWN=180
